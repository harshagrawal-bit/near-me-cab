# ---- Secrets ----
# Every env file, not just `.env` — a committed `.env.backup-*` leaked the
# live JWT signing key once, which is an admin token for anyone with the repo.
.env
.env.*
!.env.example
.env.local
.env.*.local
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Runtime / local data ----
.data/
logs/
*.log

# Reference screenshots shared for design work, not part of the app.
WhatsApp*/

# Uploaded driver documents — identity scans, never committed.
backend/uploads/
uploads/
