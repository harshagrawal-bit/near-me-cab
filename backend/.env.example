# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Runtime
ENV=development
DEBUG=true
PROJECT_NAME=LocalRide API
API_V1_PREFIX=/api

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=localride

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=localride_refresh
# Must be true in production (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (in-process; use Redis for multi-worker deployments)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# /auth/refresh gets its own, looser bucket (fires once per page load)
REFRESH_RATE_LIMIT=120
REFRESH_RATE_WINDOW_SECONDS=60
WRITE_RATE_LIMIT=60
WRITE_RATE_WINDOW_SECONDS=60

# Bootstrap admin created by scripts/seed.py
SEED_ADMIN_EMAIL=admin@localride.in
SEED_ADMIN_PASSWORD=Admin@12345

# External services — leave blank until actually integrated
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
