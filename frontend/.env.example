# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env`.
#
# Only put PUBLIC values here — anything prefixed VITE_ is compiled into the
# JavaScript bundle and is visible to anyone who opens the site. Never put a
# JWT secret, database URI or payment secret key in this file.
# ---------------------------------------------------------------------------

# Base URL for API calls. Leave empty in development to use the Vite proxy
# (same-origin, so the httpOnly refresh cookie works without CORS juggling).
VITE_API_BASE_URL=

# Where the dev proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Brand — change these to rebrand the app without touching any component.
VITE_BRAND_NAME=NearMe Cab
VITE_BRAND_TAGLINE=A cab, near you.
VITE_BRAND_SUPPORT_PHONE=9000000000
VITE_BRAND_SUPPORT_EMAIL=support@nearmecab.in

# OAuth client id for "Sign in with Google". Public by design — it is compiled
# into the bundle. The Google button hides itself when this is blank.
VITE_GOOGLE_CLIENT_ID=

# Google Maps browser key (safe to expose ONLY if HTTP-referrer restricted in
# Google Cloud Console). Leave blank until maps are actually integrated.
VITE_GOOGLE_MAPS_API_KEY=
